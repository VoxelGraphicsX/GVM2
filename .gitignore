# Public source distribution: only these root entries may be tracked.
/*
!/.gitignore
!/.gitattributes
!/CMakeLists.txt
!/main.cpp
!/LICENSE
!/NOTICE
!/THIRD_PARTY_NOTICES.md
!/.github/
!/cmake/
!/GVM/
!/UGLC/
!/GVMRHI_Samples/
!/GVMRuntime_Samples/
!/GVMRuntime_ThreeSamples/
!/tests/
!/licenses/

# OS and editor noise
.DS_Store
Thumbs.db
*.swp
*.swo
*.tmp
*.log
*.pid

# CMake and native build output
build/
build-*/
