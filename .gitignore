cmake_install.cmake
install_manifest.txt
compile_commands.json
Testing/
CTestTestfile.cmake
*.ninja
.ninja_deps
.ninja_log

# C/C++ build products
*.o
*.obj
*.lo
*.a
*.lib
*.so
*.dylib
*.dll
*.exe
*.out
*.app
*.dSYM/

# Xcode and Apple platform output
DerivedData/
