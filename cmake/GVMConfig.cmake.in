@PACKAGE_INIT@

set(GVM_PACKAGE_ENABLE_VULKAN @GVM_RHI_ENABLE_VULKAN@)
set(GVM_PACKAGE_ENABLE_LOGGING @GVM_RHI_ENABLE_LOGGING@)
set(GVM_PACKAGE_ENABLE_CPU_PROBES @GVM_RHI_ENABLE_CPU_PROBES@)
set(GVM_PACKAGE_USE_SPDLOG_LOGGER @GVM_RHI_USE_SPDLOG_LOGGER@)

include("${CMAKE_CURRENT_LIST_DIR}/GVMPackageDependencies.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/GVMTargets.cmake")
if(NOT TARGET GVM::EASTL)
    add_library(GVM::EASTL ALIAS GVM::EASTLHelper)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/UGLCompile.cmake")

check_required_components(GVM)
