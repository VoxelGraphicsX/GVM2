@PACKAGE_INIT@

if(MSVC AND NOT "@CMAKE_MSVC_RUNTIME_LIBRARY@" STREQUAL "")
    if(NOT DEFINED CMAKE_MSVC_RUNTIME_LIBRARY)
        set(CMAKE_MSVC_RUNTIME_LIBRARY "@CMAKE_MSVC_RUNTIME_LIBRARY@")
    elseif(NOT CMAKE_MSVC_RUNTIME_LIBRARY STREQUAL "@CMAKE_MSVC_RUNTIME_LIBRARY@")
        message(FATAL_ERROR "GVM MSVC runtime library conflict: installed GVM SDK requires CMAKE_MSVC_RUNTIME_LIBRARY='@CMAKE_MSVC_RUNTIME_LIBRARY@', but the consumer configured '${CMAKE_MSVC_RUNTIME_LIBRARY}'.")
    endif()
endif()

set(GVM_PACKAGE_ENABLE_VULKAN @GVM_RHI_ENABLE_VULKAN@)
set(GVM_PACKAGE_ENABLE_LOGGING @GVM_RHI_ENABLE_LOGGING@)
set(GVM_PACKAGE_ENABLE_CPU_PROBES @GVM_RHI_ENABLE_CPU_PROBES@)
set(GVM_PACKAGE_USE_SPDLOG_LOGGER @GVM_RHI_USE_SPDLOG_LOGGER@)

include("${CMAKE_CURRENT_LIST_DIR}/GVMPackageDependencies.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/GVMTargets.cmake")
if(NOT TARGET GVM::EASTL)
    add_library(GVM::EASTL ALIAS GVM::EASTLHelper)
endif()
if((TARGET marl::marl OR TARGET marl) AND NOT TARGET GVM::MarlExecutor)
    add_library(GVM::MarlExecutor INTERFACE IMPORTED)
    target_compile_features(GVM::MarlExecutor INTERFACE cxx_std_20)
    if(TARGET marl::marl)
        target_link_libraries(GVM::MarlExecutor INTERFACE GVM::Core marl::marl)
    else()
        target_link_libraries(GVM::MarlExecutor INTERFACE GVM::Core marl)
    endif()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/UGLCompile.cmake")

check_required_components(GVM)
